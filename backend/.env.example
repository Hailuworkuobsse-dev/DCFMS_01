NODE_ENV=development
# Set PORT=3001 when running alongside the frontend dev server (it uses :3000)
PORT=3151
DATABASE_URL=mysql://root:admin@localhost:3307/dcfms
JWT_SECRET=change_me_in_production_min_32_chars_long_random
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_too_min_32_chars_long_random
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Production signing OTP delivery: configure a provider endpoint accepting POST JSON {to, sender, message}.
# Requests include Authorization: Bearer <SMS_GATEWAY_TOKEN>; a non-2xx response fails issuance.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_SENDER=DCFMS
AUDIT_ENABLED=true
# Integration stubs (fill in when wiring external systems)
FAYDA_BASE_URL=
NMIS_BASE_URL=
OAN_BASE_URL=
PAYMENT_GATEWAY_URL=
