# ---- DCFMS frontend / BFF server ----
PORT=3000
NODE_ENV=development

# API base path used by the browser bundle (keep /api for the integrated BFF)
VITE_API_BASE_URL=/api

# Base URL of the NestJS backend. The BFF proxies /api/* to this when enabled.
# In dev, run the backend with PORT=3001 (backend/.env) to avoid clashing with :3000.
# In docker compose this is http://api:3000/api/v1
BACKEND_URL=http://localhost:3001/api/v1

# Set to false to run the frontend entirely on the in-memory mock API
# (no backend required — original demo behavior).
BACKEND_ENABLED=true
